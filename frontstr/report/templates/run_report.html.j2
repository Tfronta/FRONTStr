{# FRONTStr HTML report template.
   Self-contained. CSS/JS/data are inlined; SVG charts are pre-rendered. #}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="FRONTStr {{ payload.meta.app_version }}">
<title>FRONTStr — {{ payload.meta.sample_name }} ({{ payload.meta.panel_name }})</title>
<style>{{ css_bundle | safe }}</style>
</head>
<body>
<div class="app">

{# ====================================================================== #}
{# PAGE 1 — Cover / executive summary                                       #}
{# ====================================================================== #}
<header class="cover" id="cover">
  <h1>{{ payload.meta.sample_name }}</h1>
  <div class="subtitle">
    {{ payload.meta.panel_name }}{% if payload.meta.panel_version %} v{{ payload.meta.panel_version }}{% endif %}
    {% if payload.meta.operator %} · operator {{ payload.meta.operator }}{% endif %}
    {% if payload.meta.run_id %} · run {{ payload.meta.run_id }}{% endif %}
  </div>
  <div class="meta">
    <span>Platform: {{ payload.meta.platform|upper }}</span>
    <span>Reference: {{ payload.meta.reference_build }}</span>
    <span>Generated: {{ payload.meta.started_at }}</span>
    <span>FRONTStr {{ payload.meta.app_version }}</span>
  </div>
  <div class="kpi-grid">
    <div class="kpi"><b>{{ payload.summary.loci_total }}</b>loci in panel</div>
    <div class="kpi"><b>{{ payload.summary.loci_called }}</b>called</div>
    <div class="kpi {% if payload.summary.tri_count %}warn{% endif %}"><b>{{ payload.summary.tri_count }}</b>tri-allelic</div>
    <div class="kpi {% if payload.summary.dropouts %}warn{% endif %}"><b>{{ payload.summary.dropouts }}</b>drop-outs</div>
    <div class="kpi {% if payload.summary.mixture_count %}danger{% endif %}"><b>{{ payload.summary.mixture_count }}</b>mixture alert</div>
  </div>
</header>

<nav class="page-tabs">
  <a href="#profile">Profile</a>
  <a href="#sequences">Sequences</a>
  <a href="#qc">QC</a>
  <a href="#loci">Per-locus</a>
  <a href="#raw">Raw / Audit</a>
</nav>

{# ====================================================================== #}
{# PAGE 2 — Forensic profile table                                          #}
{# ====================================================================== #}
<section id="profile">
  {% set profile_show_tri = payload.profile_rows | selectattr('status_chip', 'equalto', 'tri') | list | length > 0 %}
  <h2>Forensic profile <small>{{ payload.summary.loci_called }}/{{ payload.summary.loci_total }} markers called</small></h2>
  <div class="card">
    <div class="toolbar">
      <input id="profile-search" type="search" placeholder="filter markers (eg. TPOX)…" autocomplete="off">
      <select id="profile-status">
        <option value="">all statuses</option>
        <option value="ok">OK</option>
        <option value="tri">tri-allelic</option>
        <option value="mixture">mixture</option>
        <option value="no_data">no data</option>
      </select>
      <span class="pill" id="profile-count"></span>
    </div>
    <table class="profile">
      <thead>
        <tr>
          <th data-sortable="text">Marker</th>
          <th data-sortable="text">Call</th>
          <th data-sortable="text">Genotype</th>
          <th data-sortable="num">Allele 1 <span class="th-hint">CE / bp</span></th>
          <th data-sortable="num">Reads 1</th>
          <th data-sortable="num">Allele 2 <span class="th-hint">CE / bp</span></th>
          <th data-sortable="num">Reads 2</th>
          {% if profile_show_tri %}
          <th data-sortable="num">Allele 3 <span class="th-hint">CE / bp</span></th>
          <th data-sortable="num">Reads 3</th>
          {% endif %}
          <th data-sortable="num">Total</th>
          <th data-sortable="text">Status</th>
        </tr>
      </thead>
      <tbody>
      {% for row in payload.profile_rows %}
        <tr data-search="{{ row.marker|lower }} {{ row.call_rule }} {{ row.status_chip }} {{ row.tri_type }}"
            data-chip="{{ row.status_chip }}"
            class="{% if row.status_chip == 'mixture' %}row-mixture{% elif row.status_chip == 'no_data' %}row-no-data{% endif %}">
          <td class="marker"><a href="#seq-{{ row.marker|e }}" class="marker-link" data-marker="{{ row.marker|e }}" title="Show this marker's alleles in the Sequences table">{{ row.marker }}</a></td>
          <td class="mono">{{ row.call_rule }}</td>
          <td class="mono genotype">{{ row.genotype }}</td>
          <td class="num{% if row.allele1_ce_is_kit_ce %} ce-kit-ce{% endif %}"
              data-sort-value="{{ row.allele1_ce_sort if row.allele1_ce_sort is not none else '' }}"
              {% if row.allele1_ce_label %}
                {% if row.allele1_ce_is_kit_ce %}title="Allele number = repeat units counted from the called sequence: length-based CE for simple loci, ISFG bracket count for compound (period −1) loci."
                {% else %}title="Sizing only: tandem-repeat span within the marker window (compound motif; not a CODIS ladder allele)."
                {% endif %}
              {% endif %}>{{ row.allele1_ce_label if row.allele1_ce_label else '–' }}</td>
          <td class="num" data-sort-value="{{ row.allele1_cov or 0 }}">{{ row.allele1_cov if row.allele1_cov is not none else '–' }}</td>
          <td class="num{% if row.allele2_ce_is_kit_ce %} ce-kit-ce{% endif %}"
              data-sort-value="{{ row.allele2_ce_sort if row.allele2_ce_sort is not none else '' }}"
              {% if row.allele2_ce_label %}
                {% if row.allele2_ce_is_kit_ce %}title="Allele number = repeat units counted from the called sequence: length-based CE for simple loci, ISFG bracket count for compound (period −1) loci."
                {% else %}title="Sizing only: tandem-repeat span within the marker window (compound motif; not a CODIS ladder allele)."
                {% endif %}
              {% endif %}>{{ row.allele2_ce_label if row.allele2_ce_label else '–' }}</td>
          <td class="num" data-sort-value="{{ row.allele2_cov or 0 }}">{{ row.allele2_cov if row.allele2_cov is not none else '–' }}</td>
          {% if profile_show_tri %}
          <td class="num{% if row.allele3_ce_is_kit_ce %} ce-kit-ce{% endif %}"
              data-sort-value="{{ row.allele3_ce_sort if row.allele3_ce_sort is not none else '' }}"
              {% if row.allele3_ce_label %}
                {% if row.allele3_ce_is_kit_ce %}title="Allele number = repeat units counted from the called sequence: length-based CE for simple loci, ISFG bracket count for compound (period −1) loci."
                {% else %}title="Sizing only: tandem-repeat span within the marker window (compound motif; not a CODIS ladder allele)."
                {% endif %}
              {% endif %}>{{ row.allele3_ce_label if row.allele3_ce_label else '–' }}</td>
          <td class="num" data-sort-value="{{ row.allele3_cov or 0 }}">{{ row.allele3_cov if row.allele3_cov is not none else '–' }}</td>
          {% endif %}
          <td class="num">{{ row.total_reads }}</td>
          <td>
            <span class="chip {{ row.status_chip }}">{{ row.status_chip }}</span>
            {% if row.has_iso %}<span class="chip iso" title="Isoalleles present — same allele number, different sequence. See Sequences table.">iso</span>{% endif %}
            {% if row.tri_type %}<span class="chip tri">{{ row.tri_type }}</span>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="profile-note"><strong>CE-based genotype.</strong> Each row is one marker. <strong>Genotype</strong> is the called allele numbers; <strong>Allele N</strong> + <strong>Reads N</strong> give the per-allele number and its individual coverage. <strong>Total</strong> is all spanning reads (includes stutter / noise peaks not genotype-called). <strong>Allele number</strong> = repeat units counted from the called sequence: length-based CE for simple loci (<code>period ≥ 1</code>), ISFG bracket count for compound loci (<code>period: -1</code>: vWA, FGA, D21S11, D3S1358 …); cross-comparable with CE / Illumina / other callers. <strong>Caveat:</strong> for vWA and D21S11 the legacy CE-kit nomenclature does not map 1:1 to the bracket count — interpret alongside the ISFG string in the Sequences table. The <span class="chip iso">iso</span> chip flags isoalleles (same number, different sequence): click the marker to see them.</p>
  </div>
</section>

{# ====================================================================== #}
{# PAGE 2b — Sequencing-based table (the FRONTStr differential)             #}
{# ====================================================================== #}
<section id="sequences">
  <h2>Sequences <small>per-allele ISFG, iso-alleles &amp; full consensus</small></h2>
  <div class="card">
    <div class="toolbar">
      <input id="seq-search" type="search" placeholder="filter by marker, allele or ISFG…" autocomplete="off">
      <button type="button" id="seq-clear" class="btn-soft">clear</button>
      <span class="pill" id="seq-count"></span>
    </div>
    <table class="profile seqtable">
      <thead>
        <tr>
          <th data-sortable="text">Marker</th>
          <th data-sortable="num">Allele</th>
          <th data-sortable="text">Iso</th>
          <th data-sortable="num">Reads</th>
          <th data-sortable="text">HP1/HP2</th>
          <th data-sortable="text">ISFG (brackets)</th>
          <th data-sortable="num">len bp</th>
          <th>Sequence</th>
        </tr>
      </thead>
      <tbody>
      {% for s in payload.seq_rows %}
        <tr data-marker="{{ s.marker|e }}"
            data-search="{{ s.marker|lower }} {{ s.number|lower }} {{ s.iso|lower }} {{ s.isfg|lower }} {{ s.status }}">
          <td class="marker" id="{% if s.allele_index == 1 %}seq-{{ s.marker|e }}{% endif %}">{{ s.marker }}</td>
          <td class="num">{{ s.number }}</td>
          <td class="mono">{% if s.iso %}<span class="chip iso">{{ s.iso }}</span>{% else %}–{% endif %}</td>
          <td class="num"><b>{{ s.n_reads_total }}</b></td>
          <td class="num">{{ s.n_reads_hp1 }}/{{ s.n_reads_hp2 }}</td>
          <td class="mono repeat-line">{{ s.isfg or '–' }}</td>
          <td class="num">{{ s.length_bp }}</td>
          <td>
            {% if s.consensus %}
            <div class="seq-actions">
              <button type="button" class="btn-soft" data-copy="{{ s.consensus }}">copy</button>
              <details class="seq-expand"><summary>{{ s.length_bp }} bp</summary><div class="seq-full mono">{{ s.consensus }}</div></details>
            </div>
            {% else %}<span class="dim">deletion</span>{% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="profile-note"><strong>Sequencing-based view — the FRONTStr differential.</strong> One row per called allele. <strong>ISFG (brackets)</strong> is the compact sequence form that distinguishes <em>iso-alleles</em>: two alleles with the same number but different motif structure (e.g. <code>15a</code> vs <code>15b</code>) — something CE electrophoresis cannot resolve. The full consensus is available per allele via <em>copy</em> or the expandable <em>bp</em> control, so it never bloats the table. Click a marker in the CE table above to filter this table to that locus.</p>
  </div>
</section>

{# ====================================================================== #}
{# PAGE 3 — QC dashboard                                                    #}
{# ====================================================================== #}
<section id="qc">
  <h2>Quality control <small>mean {{ "%.1f"|format(payload.qc.mean_coverage) }}x · min {{ payload.qc.min_coverage }}x · max {{ payload.qc.max_coverage }}x</small></h2>
  <div class="card">
    <h3 style="font-size:13px;margin:0 0 8px;color:var(--text-soft);">Coverage per locus</h3>
    {{ qc_coverage_svg | safe }}
  </div>
  <div class="card" style="margin-top:14px;">
    <h3 style="font-size:13px;margin:0 0 8px;color:var(--text-soft);">Cluster status distribution</h3>
    <table class="profile">
      <thead><tr><th>Status</th><th class="num">Clusters</th></tr></thead>
      <tbody>
      {% for entry in payload.qc.status_breakdown %}
        <tr><td><span class="chip {{ entry.status }}">{{ entry.status }}</span></td><td class="num">{{ entry.count }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
  </div>
</section>

{# ====================================================================== #}
{# PAGE 4 — Per-locus detail                                                #}
{# ====================================================================== #}
<section id="loci">
  <h2>
    Per-locus detail
    <small>
      <button id="expand-all" type="button" style="font:inherit;cursor:pointer;background:none;border:0;color:var(--primary);padding:0;">expand all</button>
      ·
      <button id="collapse-all" type="button" style="font:inherit;cursor:pointer;background:none;border:0;color:var(--primary);padding:0;">collapse</button>
    </small>
  </h2>
  {% for r in payload.results %}
    <details class="locus" id="locus-{{ r.marker_name|e }}"
             {% if r.tri_type or r.call_rule == 'no_data' %}open{% endif %}>
      <summary>
        <b>{{ r.marker_name }}</b>
        <span class="chip {% if r.tri_type == 'mixture_suspected' %}mixture{% elif r.tri_type %}tri{% elif r.call_rule == 'no_data' %}no_data{% else %}ok{% endif %}">{{ r.call_rule }}</span>
        {% if r.tri_type %}<span class="chip tri">{{ r.tri_type }}</span>{% endif %}
        <span class="meta">{{ r.system.chromosome }}:{{ r.system.ref_start }}-{{ r.system.ref_end }} · motif {{ r.system.motif }} · {{ r.total_reads }} reads</span>
      </summary>
      <div class="body locus-body">
        <div class="locus-ngs-full">
          <div class="locus-meta">
            <span><b>Motif</b> {{ r.system.motif }}</span>
            <span><b>Period</b> {{ r.system.period }}</span>
            <span><b>Category</b> {{ r.system.category }}</span>
            <span><b>Allow tri</b> {{ 'yes' if r.system.allow_triallelic else 'no' }}</span>
            <span><b>Reads</b> {{ r.total_reads }}</span>
          </div>
          <div class="ngs-panel" data-marker="{{ r.marker_name|e }}">
            <div class="ngs-panel-head">
              <h3 class="ngs-panel-title">{{ r.ngs_panel.title }}</h3>
              <p class="ngs-panel-sub">{{ r.ngs_panel.subtitle }}</p>
            </div>
            {% if r.ngs_panel.rows %}
            <table class="ngs-table">
              <thead>
                <tr>
                  <th>Allele</th>
                  <th class="num">Coverage <span class="th-hint">(reads)</span></th>
                  <th>Repeat Sequence</th>
                  <th>Full Sequence</th>
                </tr>
              </thead>
              <tbody>
              {% for row in r.ngs_panel.rows %}
                <tr class="ngs-row" data-row-id="{{ row.id|e }}" tabindex="0" role="button">
                  <td class="allele-cell">{{ row.allele_display }}{% if row.is_isoallele %}<sup class="allele-iso">iso{% if row.iso_ordinal > 1 %}{{ row.iso_ordinal }}{% endif %}</sup>{% endif %}</td>
                  <td class="num cov-cell" title="{{ '%.2f'|format(row.coverage_fraction_pct) }}% of locus reads"><b>{{ row.coverage_reads }}</b></td>
                  <td class="mono">{{ row.repeat_sequence }}</td>
                  <td class="mono sequence-cell"><div class="sequence-scroll">{{ row.full_sequence_html | safe }}</div></td>
                </tr>
              {% endfor %}
              </tbody>
            </table>
            {% else %}
            <p class="ngs-empty">No alleles in the NGS summary panel for this locus.</p>
            {% endif %}
            <div class="ngs-chart-wrap">
              {{ r.svg_allele_coverage | safe }}
            </div>
          </div>
          {% if r.flags %}
          <div style="margin-top:10px;font-size:12px;">
            {% for f in r.flags %}<div class="flag flag-{{ f.severity }}" title="{{ f.code }}">{% if f.severity == 'error' %}⛔{% elif f.severity == 'warn' %}⚠{% else %}ℹ{% endif %} <code>{{ f.code }}</code> — {{ f.message }}</div>{% endfor %}
          </div>
          {% endif %}
        </div>
        <div class="locus-split">
          <div class="locus-split-main">
          <details class="forensic-audit">
            <summary><b>Forensic audit</b><span class="meta"> — all clusters</span></summary>
            <table class="allele-table">
            <thead>
              <tr>
                <th>#</th><th>ISFG</th><th>Motif runs</th><th class="num">CE</th><th class="num">len bp</th>
                <th class="num">reads</th><th class="num">HP1/HP2</th><th class="num">+/-</th>
                <th class="num">mean Q</th><th class="num">ES</th><th>status</th><th>Sequence</th>
              </tr>
            </thead>
            <tbody>
            {% for a in r.alleles %}
              <tr class="is-{{ a.status }}">
                <td>{{ a.cluster_index }}</td>
                <td class="mono">{{ a.isfg }}</td>
                <td class="mono" style="font-size:11px;color:var(--text-soft);">{{ a.motif_repeat_summary }}</td>
                <td class="num">{{ '%.1f'|format(a.ce) if a.ce is not none else '–' }}</td>
                <td class="num">{{ a.length_bp }}</td>
                <td class="num"><b>{{ a.n_reads_total }}</b></td>
                <td class="num">{{ a.n_reads_hp1 }}/{{ a.n_reads_hp2 }}</td>
                <td class="num">{{ a.n_forward }}/{{ a.n_reverse }}</td>
                <td class="num">{{ a.mean_qual }}</td>
                <td class="num">{{ a.expected_stutter }}</td>
                <td><span class="chip {{ 'ok' if a.status == 'allele' else 'no_data' }}">{{ a.status }}</span>
                </td>
                <td class="mono seq-cell" style="font-size:11px;color:var(--text-soft);word-break:break-all;">{{ a.consensus or '–' }}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
          </details>
          </div>
          <aside class="locus-split-aside">
          <div style="font-size:11px;color:var(--text-soft);margin-bottom:6px;">Haplotype split</div>
          {{ r.svg_haplotype | safe }}
          </aside>
        </div>
      </div>
    </details>
  {% endfor %}
</section>

{# ====================================================================== #}
{# PAGE 5 — Raw / Audit                                                     #}
{# ====================================================================== #}
<section id="raw">
  <h2>Raw / audit</h2>
  <div class="card">
    <h3 style="font-size:13px;margin:0 0 8px;color:var(--text-soft);">Chain of custody (SHA-256)</h3>
    <dl class="raw-grid">
      <dt>Sample</dt><dd>{{ payload.meta.sample_name }}</dd>
      {% if payload.meta.bam_path %}
      <dt>BAM</dt><dd><span class="hash">{{ payload.meta.bam_sha256 or '–' }}</span> <button class="mono" type="button" data-copy="{{ payload.meta.bam_sha256 or '' }}" style="font-size:10px;cursor:pointer;">copy</button></dd>
      <dt>BAM path</dt><dd>{{ payload.meta.bam_path }}</dd>
      {% endif %}
      {% if payload.meta.panel_sha256 %}
      <dt>Panel</dt><dd><span class="hash">{{ payload.meta.panel_sha256 }}</span></dd>
      {% endif %}
      <dt>Report</dt><dd><span class="hash" id="report-hash">@@REPORT_SHA256@@</span></dd>
    </dl>
    {% if payload.meta.pipeline_argv %}
    <h3 style="font-size:13px;margin:16px 0 8px;color:var(--text-soft);">Pipeline command</h3>
    <pre class="argv">{{ payload.meta.pipeline_argv | join(' ') }}</pre>
    {% endif %}
  </div>

  {% if payload.audit %}
  {% set audit = payload.audit %}
  <div class="card" style="margin-top:14px;">
    <h3 style="font-size:13px;margin:0 0 8px;color:var(--text-soft);">Run configuration</h3>
    <dl class="raw-grid">
      <dt>FRONTStr</dt><dd>{{ audit.tool_version }}</dd>
      <dt>POA backend</dt>
      <dd>{% if audit.poa_backend == 'none' %}<b style="color:var(--warn,#b58900);">none — consensus unpolished</b>{% else %}{{ audit.poa_backend }}{% endif %}</dd>
      <dt>Stutter model</dt>
      <dd>{{ audit.stutter_model_version }} <span class="meta">({{ audit.stutter_model_protocol }})</span></dd>
      <dt>Analytical / calling</dt><dd>{{ audit.analytical_thresh }} / {{ audit.calling_thresh }}</dd>
      <dt>Low-coverage floor</dt><dd>{{ audit.qc_thresholds.low_coverage_reads }} reads</dd>
      <dt>Strand-bias test</dt>
      <dd>p &lt; {{ audit.qc_thresholds.strand_bias_p }}, min {{ audit.qc_thresholds.strand_bias_min_reads }} reads</dd>
      <dt>Audit record</dt><dd><span class="hash">{{ audit.integrity_sha256 }}</span></dd>
    </dl>

    <h3 style="font-size:13px;margin:16px 0 8px;color:var(--text-soft);">
      Conditions checked
      <span class="meta">— every condition below was evaluated; those not listed as raised were checked and not found</span>
    </h3>
    <ul class="raw-grid" style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:6px;">
      {% for code in audit.flags_checked %}
      <li class="chip {% if audit.flag_counts.get(code) %}chip-flagged{% else %}chip-clear{% endif %}"
          style="font-size:11px;">
        {{ code }}{% if audit.flag_counts.get(code) %} ×{{ audit.flag_counts[code] }}{% endif %}
      </li>
      {% endfor %}
    </ul>

    {% if audit.markers_needing_review %}
    <p class="meta" style="margin-top:12px;">
      <b>{{ audit.markers_needing_review | length }}</b> marker(s) carry a warning or error:
      {{ audit.markers_needing_review | join(', ') }}
    </p>
    {% else %}
    <p class="meta" style="margin-top:12px;">No marker raised a warning or error.</p>
    {% endif %}
  </div>
  {% endif %}
  <details class="locus" id="run-data-blob" style="margin-top:14px;">
    <summary><b>Embedded run payload (JSON)</b><span class="meta">click to inspect</span></summary>
    <pre class="argv" style="max-height:60vh;overflow:auto;">{{ run_data_json_pretty | safe }}</pre>
  </details>
</section>

<footer class="report-footer">
  <span>FRONTStr {{ payload.meta.app_version }}</span>
  <span>Sample <b>{{ payload.meta.sample_name }}</b></span>
  <span class="hash">sha256 <span id="report-hash-footer">@@REPORT_SHA256@@</span></span>
</footer>

{# Embed full payload for programmatic extraction (no fetch needed). #}
<script type="application/json" id="run-data">{{ run_data_json | safe }}</script>
<script>{{ app_js_bundle | safe }}</script>

</div>
</body></html>
